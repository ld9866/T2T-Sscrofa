#!/bin/bash

###############################################################################
# Genomic Repeat & Multicopy Element Analysis Pipeline
#
# Author: Lidong
# Date: 2026-03-09
# Updated: 2026-08-10
# Description:
#   1. Identification of Segmental Duplications (SD) using BISER.
#   2. Prediction and extraction of ribosomal DNA (rDNA) using Barrnap.
#   3. Structural characterization of high-copy elements for T2T assembly.
#   4. rDNA copy number estimation and representative 18S sequence extraction.
###############################################################################

# =============================================================================
# 1. Configuration & Input Setup
# =============================================================================

# Software & Tools
BISER="biser"
BARRNAP="barrnap"
CONKORD="python /path/to/conkord.py"  # UPDATE: Replace with actual path
SNAKEMAKE="snakemake"

# Input Files
REF_FASTA="tabasco.pig.fa"
SOFTMASK_FASTA="tabasco.softmask.fa"
CONFIG_YAML="/path/to/config.yml"     # UPDATE: Replace with actual path
SNAKEFILE="/path/to/Snakefile"        # UPDATE: Replace with actual path

# Output Prefix & Resources
PREFIX="tabasco.pig"
THREADS=128
GC_HEAP="10G"

# rDNA related directories
RDNA_DIR="rDNA_analysis"
RDNA_FA="${PREFIX}.rDNA.fa"
RDNA_GFF="${PREFIX}.rDNA.gff"

# =============================================================================
# 2. Segmental Duplication (SD) Discovery
# =============================================================================
echo "[$(date)] Running BISER for Segmental Duplication (SD) detection..."

${BISER} \
    -o ${PREFIX}.SD_annotations \
    -t 8 \
    --gc-heap ${GC_HEAP} \
    ${SOFTMASK_FASTA}

# =============================================================================
# 3. Ribosomal DNA (rDNA) Identification
# =============================================================================
echo "[$(date)] Starting Barrnap for rDNA locus prediction..."

${BARRNAP} \
    --kingdom euk \
    --threads ${THREADS} \
    --outseq ${RDNA_FA} \
    ${REF_FASTA} > ${RDNA_GFF}

echo "[$(date)] rDNA search complete. Summary of detected loci:"
grep -v "#" ${RDNA_GFF} | cut -f 9 | cut -d ";" -f 1 | sort | uniq -c

# =============================================================================
# 4. rDNA Copy Number Estimation (CONKORD workflow)
# =============================================================================
echo "[$(date)] Starting rDNA Copy Number Estimation pipeline..."

mkdir -p ${RDNA_DIR}
cd ${RDNA_DIR}

# 4.1 Extract 18S rDNA sequences
echo "Extracting 18S rDNA sequences from barrnap output..."
seqkit grep -r -p "18S" ../${RDNA_FA} > ${PREFIX}.18S.fa

# 4.2 MAFFT alignment
echo "Running MAFFT multiple sequence alignment..."
mafft --auto --thread ${THREADS} ${PREFIX}.18S.fa > ${PREFIX}.18S.aligned.fa

# 4.3 Generate consensus sequence and best representative
echo "Generating consensus and finding best representative 18S sequence..."

# Generate consensus.py script
cat > consensus.py << 'EOF'
from Bio import AlignIO
from collections import Counter

alignment = AlignIO.read("${PREFIX}.18S.aligned.fa", "fasta")
seq_len = alignment.get_alignment_length()
print(f"Alignment length: {seq_len} bp")
print(f"Number of sequences: {len(alignment)}")

consensus_seq = []
for i in range(seq_len):
    column = [rec.seq[i] for rec in alignment if rec.seq[i] != '-']
    if not column:
        consensus_seq.append('N')
    else:
        counter = Counter(column)
        most_common_base = counter.most_common(1)[0][0]
        consensus_seq.append(most_common_base)

consensus_str = ''.join(consensus_seq)
with open("${PREFIX}.18S.consensus.fa", "w") as f:
    f.write(">${PREFIX}_18S_consensus\n")
    for i in range(0, len(consensus_str), 60):
        f.write(consensus_str[i:i+60] + "\n")

print(f"Consensus sequence saved to ${PREFIX}.18S.consensus.fa")
EOF

# Generate bestclose.py script
cat > bestclose.py << 'EOF'
from Bio import SeqIO
import sys

consensus_record = SeqIO.read('${PREFIX}.18S.consensus.fa', 'fasta')
consensus_seq = str(consensus_record.seq).upper()
print(f'Consensus length: {len(consensus_seq)} bp')

aligned_records = list(SeqIO.parse('${PREFIX}.18S.aligned.fa', 'fasta'))
print(f'Number of aligned sequences: {len(aligned_records)}')

results = []
for rec in aligned_records:
    seq_str = str(rec.seq).upper()
    if len(seq_str) != len(consensus_seq):
        print(f'Warning: Sequence {rec.id} length mismatch. Skipping.')
        continue
    
    diff = 0
    total_compared = 0
    for a, b in zip(seq_str, consensus_seq):
        if a != '-' and b != '-':
            total_compared += 1
            if a != b:
                diff += 1
    
    similarity = (1 - diff / total_compared) * 100 if total_compared > 0 else 0
    results.append((rec.id, diff, total_compared, similarity))

results.sort(key=lambda x: x[1])

print('\nTop 10 sequences closest to the consensus:')
print('Rank\tDifferences\tSimilarity(%)\tSequence ID')
print('-' * 80)
for i, (seq_id, diff, total, sim) in enumerate(results[:10], 1):
    print(f'{i:2d}\t{diff:8d}\t{sim:8.2f}\t{seq_id}')

best_id = results[0][0]
print(f'\nBest representative sequence ID: {best_id}')
print(f'Command to extract: seqkit grep -p "{best_id}" ${PREFIX}.18S.fa > representative_18S.fa')
EOF

# Execute Python scripts
echo "Running consensus generation..."
python3 consensus.py

echo "Finding best representative sequence..."
python3 bestclose.py

# Extract the final representative sequence
REP_ID=$(grep "Best representative sequence ID:" bestclose.log | cut -d ":" -f 2 | xargs)
seqkit grep -p "${REP_ID}" ${PREFIX}.18S.fa > representative_18S.fa

# 4.4 Run CONKORD for copy number estimation
echo "Running CONKORD for copy number estimation..."
${CONKORD} \
    --no_uniq \
    -k 31 \
    -bed feature_coordinates.bed \
    -f representative_18S.fa \
    -r sequencing_data/ \
    -t 15 \
    --cluster \
    -g ../${REF_FASTA} \
    --gzip

echo "Executing CONKORD Snakemake pipeline..."
${SNAKEMAKE} -s ${SNAKEFILE} --configfile ${CONFIG_YAML} --cores 64 -p

cd ../

# =============================================================================
# 5. Final Summary
# =============================================================================
echo "-------------------------------------------------------"
echo "Repeat Analysis Pipeline Finished at $(date)"
echo "SD Output: ${PREFIX}.SD_annotations/"
echo "rDNA Output: ${RDNA_GFF} and ${RDNA_FA}"
echo "rDNA Copy Number Result: ${RDNA_DIR}/"
echo "-------------------------------------------------------"
